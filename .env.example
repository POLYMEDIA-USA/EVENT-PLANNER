# FunnelFlow environment variables.
#
# Copy to .env.local for local development. Nothing in this file is a secret:
# application-level secrets (SMTP password, Vonage keys) deliberately do NOT
# live here — they are stored in settings.json in GCS and edited from the
# in-app Settings page, so an admin can rotate them without a redeploy.
#
# In production these are set on the Cloud Run service with --set-env-vars.

# GCS bucket holding every JSON data file. REQUIRED locally: the default
# fallback is event-planner-bucket, which has billing disabled and 403s on
# every read, which looks like a broken app rather than a missing env var.
GCS_BUCKET=corpmarketer-bucket

# VerifyAi auth-api, used purely as a yes/no credential oracle for accounts with
# auth_source='verifyai' and for VerifyAi-gated self-registration. Public Cloud
# Run URL, not a secret. Only set this to point at VerifyAi staging; the code
# defaults to production.
# VERIFYAI_AUTH_API_URL=https://verifyai-auth-api-production-143845647654.us-central1.run.app

# Access Portal, the fleet identity provider. Its /.well-known/jwks.json is
# fetched to verify the shared verifyai_session cookie, and its /logout ends the
# fleet-wide session. Only set this to point at a staging Portal; the code
# defaults to https://portal.verifyai.net.
#
# NOTE: the shared cookie is scoped Domain=verifyai.net, so single sign-on only
# takes effect when FunnelFlow is served from a verifyai.net subdomain
# (events.verifyai.net). On a *.run.app URL the cookie is never sent, the SSO
# exchange simply returns "no cookie", and the normal login form is used.
# PORTAL_BASE_URL=https://portal.verifyai.net
